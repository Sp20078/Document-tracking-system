# --- Secrets ---
# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-64-char-random-hex-string

# --- Database (MySQL 8.0+) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=document_tracking
DB_USER=dts_user
DB_PASSWORD=change-me-db-password
# Optional root credentials used ONLY by scripts/init_db.py to create schema+user
DB_ROOT_PASSWORD=

# --- Uploads ---
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=10

# --- Flask ---
FLASK_ENV=development
SESSION_COOKIE_SECURE=0
